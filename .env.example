# Copy to .env and adjust. `.env` is git-ignored; never commit real values.
#
# Every variable below is declared in apps/web/src/env.ts, and a test fails if
# the two lists stop matching. `pnpm check:security` judges a filled-in copy of
# this file the way a production boot would.
#
# "Required in" says where a value has to be present:
#   dev      - a local checkout
#   preview  - a Vercel preview deployment
#   prod     - production; a missing one makes the deployment refuse to start

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required in: dev, preview, prod.
# `pnpm db:up` starts the docker-compose Postgres these defaults point at. It
# is published on the loopback address only, so these throwaway credentials are
# reachable from this machine and nowhere else; any Postgres 16 URL works here
# instead, including a Neon one.
DATABASE_URL=postgres://budget_bot:budget_bot@localhost:5433/budget_bot

# Required in: dev (only to run the packages/db suite). Never set in prod.
# This database is dropped and rebuilt freely, so it must never be the
# development one. Create it once with:
#   pnpm --filter @budget-bot/db db:test:setup
# The suite skips itself with a message when this database is unreachable.
DATABASE_URL_TEST=postgres://budget_bot:budget_bot@localhost:5433/budget_bot_test

# ---------------------------------------------------------------------------
# Storage switch (temporary, removed once pages read from Postgres)
# ---------------------------------------------------------------------------
# Required in: prod, where it must be 1. Optional in dev.
# Unset or 0: apps/web reads and writes the legacy JSON file store, which holds
# one unscoped copy of the books and ignores who is signed in.
# 1: apps/web reads and writes Postgres through @budget-bot/db, scoped to the
# session's user.
USE_PG=0

# ---------------------------------------------------------------------------
# Sign-in (ADR 0003)
# ---------------------------------------------------------------------------
# Required in: preview, prod. Optional in dev (Auth.js generates one, and the
# app runs without sign-in until you configure the GitHub app below).
# Signs and encrypts the session cookie. At least 32 characters. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Required in: preview, prod. A GitHub OAuth app you create yourself at
#   https://github.com/settings/developers
# Its Authorization callback URL must be:
#   https://<your-host>/api/auth/callback/github
# For local development, create a second OAuth app pointing at
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Required in: nowhere, usually. Auth.js works out the deployment URL from the
# request; set this only when it cannot - behind a proxy that rewrites the
# host, or on a custom domain the framework does not see.
AUTH_URL=

# Required in: preview, prod. Who is allowed to sign in, comma-separated. The
# comparison folds case and ignores spaces, and it is checked against the
# primary *verified* address on the GitHub account. Anyone else is turned away
# before a user row exists. An empty list means nobody can sign in, so a
# production deployment refuses to start with one.
ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Bank token encryption (ADR 0002)
# ---------------------------------------------------------------------------
# Required in: prod. Optional until bank connections exist (sub-project 2).
# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Losing it means re-linking banks, not losing data.
BANK_TOKEN_ENCRYPTION_KEY=

# Required in: nowhere. Set during a key rotation so tokens written under the
# old key still decrypt; remove it once every token has been re-encrypted.
BANK_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Plaid (built in sub-projects 2-3; not read by any code yet)
# ---------------------------------------------------------------------------
# Required in: nowhere yet. `sandbox` or `production`. Previews run against
# sandbox; setting it to production also makes CRON_SECRET mandatory.
PLAID_ENV=

# Required in: prod, once PLAID_ENV=production. The bearer token the scheduled
# sync endpoint checks. Generate with:
#   openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Development convenience
# ---------------------------------------------------------------------------
# Required in: nowhere. 1 fills a user's account with the demo fixtures the
# first time they sign in, so a fresh checkout has something to look at.
# Existing users are untouched; `pnpm db:seed --owner-email you@example.com`
# does the same thing on demand.
SEED_DEMO=0
