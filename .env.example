# Copy to .env and adjust. `.env` is git-ignored; never commit real values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development database. `pnpm db:up` starts the docker-compose Postgres that
# these defaults point at; any Postgres 16 URL works, including a Neon one.
DATABASE_URL=postgres://budget_bot:budget_bot@localhost:5433/budget_bot

# Database the packages/db test suite runs against. It is dropped and rebuilt
# freely, so it must never be the development one. Create it once with:
#   pnpm --filter @budget-bot/db db:test:setup
# The suite skips itself with a message when this database is unreachable.
DATABASE_URL_TEST=postgres://budget_bot:budget_bot@localhost:5433/budget_bot_test

# ---------------------------------------------------------------------------
# Storage switch (temporary, removed once pages read from Postgres)
# ---------------------------------------------------------------------------
# Unset or 0: apps/web reads and writes the legacy JSON file store.
# 1: apps/web reads and writes Postgres through @budget-bot/db.
USE_PG=0

# Whose data the Postgres path reads while there is no sign-in yet. Must match
# the email of a row in `users`. Replaced by the Auth.js session in the next
# sub-project; ignored when USE_PG is off.
DEV_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Bank token encryption (ADR 0002) - not read by any code yet
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means re-linking banks, not losing data.
BANK_TOKEN_ENCRYPTION_KEY=

# Set during a key rotation so tokens written under the old key still decrypt.
BANK_TOKEN_ENCRYPTION_KEY_PREVIOUS=
