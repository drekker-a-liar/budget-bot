{
  "name": "budget-bot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:staged": "node scripts/lint-staged.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter web e2e",
    "check:security": "pnpm --filter web check:security",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @budget-bot/db db:generate",
    "db:migrate": "pnpm --filter @budget-bot/db db:migrate",
    "db:seed": "pnpm --filter @budget-bot/db db:seed",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12"
  }
}
